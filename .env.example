# Public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only configuration (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_KEY_ENCRYPTION_KEY=
CRON_SECRET=
PROVIDER_SEND_RATE=1

# Optional single-owner provider connection. Other users enter keys in Settings.
RESEND_API_KEY=
SERVER_SENDER_USER_ID=
RESEND_WEBHOOK_SECRET=

# Optional authenticated browser test account; never use a production contact list.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
